GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Rutas para los usuarios
+nocsrf
GET     /api/users        controllers.UserController.getUsers
+nocsrf
POST    /api/users        controllers.UserController.createUser
+nocsrf
PUT     /api/users/:id    controllers.UserController.editUser(id: String)
+nocsrf
DELETE  /api/users/:id    controllers.UserController.deleteUser(id: String)

